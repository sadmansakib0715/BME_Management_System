+  const folders: FolderAssessment[] = Array.from({ length: spec.nCt! }, (_, k) => ({
+    folder: `Assessments ${k + 1}`, name: `CT${String(k + 1).padStart(2, '0')}`, max: spec.ctMax!, values: new Map(ids.map((s) => [s, d.ct!.get(key(s, k)) ?? null])) }));
